EMPRESA_RAZON_SOCIAL="CRONIQ S.A.C."
EMPRESA_NOMBRE_COMERCIAL="Croniq"
EMPRESA_DIRECCION_FISCAL="Av. Principal 123, Distrito, Provincia, Departamento"
EMPRESA_UBIGEO=150101
